APP_NAME=Rivaify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# PayTR iFrame API — obtain these from PayTR Merchant Panel.
PAYMENT_GATEWAY=paytr
STOREFRONT_PAYMENT_PROVIDERS=paytr
STOREFRONT_ALLOW_MANUAL_PAYMENT=false
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_DEBUG=false
PAYTR_TIMEOUT=30
PAYTR_MAX_INSTALLMENT=0
PAYTR_NO_INSTALLMENT=false
PAYTR_TOKEN_URL=https://www.paytr.com/odeme/api/get-token
PAYTR_IFRAME_URL=https://www.paytr.com/odeme/guvenli
PAYTR_REFUND_URL=https://www.paytr.com/odeme/iade
FRONTEND_URL=http://localhost:5173

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rivaify
DB_USERNAME=rivaify
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_HOST_AWARE=false
SESSION_HOST_ONLY=true
APP_SESSION_COOKIE=__Host-rivaify_app_session
APP_SESSION_LIFETIME=120
APP_SESSION_SAME_SITE=lax
INTERNAL_SESSION_COOKIE=__Host-rivaify_ins_session
INTERNAL_SESSION_LIFETIME=30
INTERNAL_SESSION_SAME_SITE=strict
INTERNAL_ADMIN_HOST=ins.rivaify.com
INTERNAL_ADMIN_ENFORCE_PRIVATE_NETWORK=false
INTERNAL_ADMIN_ALLOWED_CIDRS=10.8.0.0/24,127.0.0.1/32,::1/128

# Comma-separated hosts (no scheme) that get cookie-based Sanctum auth —
# the merchant/admin React SPAs. Leave unset in local dev against
# 127.0.0.1/localhost; Sanctum defaults cover that case.
SANCTUM_STATEFUL_DOMAINS=
# Full scheme-qualified origins for CORS, matching SANCTUM_STATEFUL_DOMAINS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=rivaify_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — verification documents (private). See config/filesystems.php's 'r2' disk.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rivaify-verification-documents
R2_ENDPOINT=
R2_ACCOUNT_ID=

VITE_APP_NAME="${APP_NAME}"
